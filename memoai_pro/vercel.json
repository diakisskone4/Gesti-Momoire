{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{venv/**,frontend/**,media/**,staticfiles/**,**/__pycache__/**,**/tests.py,**/tests/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
