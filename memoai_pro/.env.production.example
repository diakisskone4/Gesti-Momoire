# Variables à définir dans Vercel : Project → Settings → Environment Variables (jamais dans Git).

# Django
DEBUG=False
SECRET_KEY=une-longue-chaine-aleatoire        # python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=memoai-backend.vercel.app        # domaine du backend (ajouté automatiquement sur Vercel)

# Base de données Neon : chaîne « Pooled connection » du tableau de bord Neon
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Frontend (CORS) : adresse du frontend une fois déployé
FRONTEND_URL=https://memoai.vercel.app
# Facultatif : autoriser aussi les prévisualisations Vercel du frontend
# CORS_ALLOWED_ORIGIN_REGEXES=^https://memoai-[a-z0-9-]+\.vercel\.app$

# IA (OpenRouter)
AI_PROVIDER=openrouter
OPENAI_API_KEY=sk-or-v1-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=baidu/ernie-5.5-flash-preview:free
AI_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free

# Paiement mobile money direct (numéros qui encaissent). Sans PAYMENT_NUMBER : paiement par Jɛmɛnipay.
PAYMENT_NUMBER=+223...
# PAYMENT_NUMBER_MOOV=+223...   (si le numéro Moov Money est différent ; idem _ORANGE et _WAVE)
# PAYMENT_HOLDER=Nom du bénéficiaire

# Paiement Jɛmɛnipay (pk_test_… = paiements simulés, pk_live_… = argent réel)
JEMENI_PUBLIC_KEY=...
JEMENI_SECRET_KEY=...
JEMENI_TOKEN=...
JEMENI_WEBHOOK_SECRET=...
MODELE_PRICE=5000

# Inscription administrateur (/admin/register)
ADMIN_REGISTRATION_CODE=...
